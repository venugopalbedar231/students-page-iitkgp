# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=students_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=
CORS_ORIGIN=

# Database connection URL
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary Credentials (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Credentials (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend Configuration (must include /api prefix)
# Example: http://student.iitkgp.ac.in/api or http://localhost:5000/api
NEXT_PUBLIC_API_URL=
