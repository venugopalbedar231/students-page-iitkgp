# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=students_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Connection string pointing to local containerized Postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/students_db?sslmode=disable

# Authentication Secrets (Replace with your secure keys if deploying to production)
JWT_SECRET=students_iitkgp_jwt_super_secret_key_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary Credentials (Optional - for image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Credentials (Optional - for real email OTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@iitkgp.ac.in

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
