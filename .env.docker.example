# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=students_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Connection string pointing to local containerized Postgres (or external DB if desired)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/students_db?sslmode=disable

# Authentication Secrets (Replace with secure keys)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary Credentials (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Credentials (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IIT Kharagpur Portal" <your_email@gmail.com>

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
