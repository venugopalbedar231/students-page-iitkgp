# Server Configuration
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS
# Add your Vercel production URL and any preview/branch deploy URLs
CORS_ORIGIN=https://students-iitkgp.vercel.app,http://localhost:3000

# PostgreSQL Database Connection URL (Neon / Supabase / etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Configuration 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IIT Kharagpur Portal" <your_email@gmail.com>

