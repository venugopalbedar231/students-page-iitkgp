# Server Configuration
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS
# Example: https://students-iitkgp.vercel.app,http://localhost:3000
FRONTEND_URL=
CORS_ORIGIN=

# PostgreSQL Database Connection URL (Neon / Supabase / Postgres)
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary (Optional - for image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Configuration (Optional - for email OTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
